---
import { ArrowLeft, Bot, Code2, GitBranch, Ticket, ShieldCheck, Lightbulb, Database, LayoutDashboard, Server, CheckCircle2 } from "lucide-react";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Card from "@/components/Card.astro";
import { projects, projectStatus } from "@/data/projects";

// Same status as the Xylo entry on the homepage, so the two never disagree.
const status = projectStatus[projects.find((project) => project.name === "Xylo")?.status ?? "ongoing"];

const features = [
	{
		title: "Ticket System",
		description: "Manage support requests through an organized ticketing system built directly into Discord.",
		icon: Ticket,
	},
	{
		title: "Verification",
		description: "Provide server members with a straightforward or captcha verification.",
		icon: ShieldCheck,
	},
	{
		title: "Suggestions",
		description:
			"Allow community members to submit ideas and suggestions while keeping the process organized and accessible.",
		icon: Lightbulb,
	},
	{
		title: "Web Dashboard",
		description: "Manage and configure Xylo through a dedicated web dashboard connected to the bot ecosystem.",
		icon: LayoutDashboard,
	},
];

const goals = [
	{
		title: "Modular",
		description: "Keep features and components separated so the ecosystem can evolve independently.",
	},
	{
		title: "Scalable",
		description: "Build a foundation capable of supporting new features and integrations over time.",
	},
	{
		title: "Practical",
		description: "Focus on features that provide real value to Discord communities.",
	},
];

const architecture = [
	{ title: "Discord Bot", description: "Handles Discord interactions and community features.", icon: Bot },
	{ title: "PostgreSQL", description: "Shared persistent data accessed through Prisma.", icon: Database },
	{
		title: "Web Dashboard",
		description: "Provides a web interface for managing and configuring Xylo.",
		icon: LayoutDashboard,
	},
];

type ChangeGroup = { feature: string[]; architecture: string[] };

const changelog: {
	version: string;
	color: string;
	date: string;
	description: string;
	added: ChangeGroup;
	removed: ChangeGroup;
	footer?: string;
}[] = [
	{
		version: "v0.1.0",
		color: "#5865F2",
		date: "22 August 2026",
		description:
			"Initial development release of Xylo, introducing the core Discord bot functionality and the foundation of the web dashboard.",
		added: {
			feature: ["Ticket system", "Verification system", "Suggestion system", "Initial web dashboard"],
			architecture: ["PostgreSQL database", "Prisma integration", "Docker-based environment", "Monorepo development setup"],
		},
		removed: {
			feature: [],
			architecture: [],
		},
		footer: "This release establishes the foundation for the future development of Xylo.",
	},
];

const changeSections = (group: ChangeGroup) =>
	[
		{ label: "Feature", items: group.feature },
		{ label: "Architecture", items: group.architecture },
	].filter((section) => section.items.length > 0);
---

<BaseLayout
	title="Xylo"
	description="Xylo: a Discord bot ecosystem for community management and automation, with a dedicated web dashboard."
>
	<main class="mx-auto mt-16 w-[80vw] max-w-[1400px] pb-12">
		{/* Back */}
		<a
			href="/"
			class="mb-6 inline-flex items-center gap-2 text-sm text-muted-foreground transition-colors hover:text-foreground"
		>
			<ArrowLeft className="size-4" />
			Back to Projects
		</a>

		{/* Hero */}
		<Card class="bg-card/70">
			<div class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between">
				<div>
					<div class="flex flex-wrap items-center gap-3">
						<div class="flex items-center gap-3">
							<Bot className="size-8 shrink-0" />
							<h1 class="font-kola text-4xl">Xylo</h1>
						</div>

						<span class={`inline-flex items-center gap-2 rounded-full border px-3 py-1 text-xs ${status.className}`}>
							<span class="size-1.5 rounded-full bg-current"></span>
							{status.label}
						</span>
					</div>

					<p class="mt-2 text-lg text-muted-foreground">Discord Bot & Web Dashboard</p>
				</div>

				<div class="flex flex-wrap gap-2">

                    <!-- Currently reworking it, so the repository will remain private -->
					<!-- <a
						href=""
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-2 rounded-full border border-border/50 bg-background/30 px-4 py-2 text-sm transition-colors hover:bg-background/50"
					>
						<GitBranch className="size-4" />
						GitHub
					</a> -->

                    <!-- Currently under rework and not online -->
					<!-- <a
						href=""
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-2 rounded-full border border-border/50 bg-background/30 px-4 py-2 text-sm transition-colors hover:bg-background/50"
					>
						<LayoutDashboard className="size-4" />
						Dashboard
					</a> -->
				</div>
			</div>

			<div class="mt-6 max-w-4xl space-y-3">
				<p class="text-muted-foreground">
					Xylo is my first real project built around a Discord ecosystem. It focuses on community management
					and automation, providing a range of useful features for Discord servers, including ticket
					management, member verification, and suggestions.
				</p>

				<p class="text-muted-foreground">
					The ecosystem is built with <span class="text-foreground">TypeScript</span>, using{" "}
					<span class="text-foreground">Discord.js</span> for the bot and{" "}
					<span class="text-foreground">Next.js</span> for the web dashboard.{" "}
					<span class="text-foreground">PostgreSQL</span> and <span class="text-foreground">Prisma</span>{" "}
					handle persistent data, while <span class="text-foreground">Docker</span> and{" "}
					<span class="text-foreground">pnpm</span> support the development workflow.
				</p>

				<p class="text-muted-foreground">
					Everything can be configured directly within Discord or through the dedicated web dashboard, with the
					project designed to remain modular as new features are introduced.
				</p>
			</div>
		</Card>

		{/* Overview + Architecture */}
		<div class="mt-4 grid gap-4 lg:grid-cols-2">
			{/* Overview */}
			<Card class="bg-card/70">
				<div class="flex items-center gap-2">
					<Code2 className="size-6" />
					<h2 class="font-kola text-2xl">Overview</h2>
				</div>

				<div class="mt-5 space-y-4 text-sm text-muted-foreground">
					<p>
						Xylo is my first real project built around a Discord ecosystem. I started it as a way to put my
						development skills into practice while creating something useful for Discord communities.
					</p>
					<p>
						The project is made up of multiple components, including the Discord bot and a dedicated web
						dashboard, with shared data managed through a PostgreSQL database.
					</p>
					<p>
						My goal is to keep Xylo modular and easy to expand, allowing me to introduce new features and
						integrations as the project grows while continuing to improve the overall architecture.
					</p>
				</div>

				{/* Project Goals */}
				<div class="mt-6 border-t border-border/50 pt-5">
					<p class="mb-3 text-xs text-muted-foreground">Project Goals</p>

					<div class="grid gap-3 sm:grid-cols-3">
						{
							goals.map((goal) => (
								<div class="rounded-2xl border border-border/50 bg-background/20 p-4">
									<p class="font-medium">{goal.title}</p>
									<p class="mt-1 text-xs text-muted-foreground">{goal.description}</p>
								</div>
							))
						}
					</div>
				</div>
			</Card>

			{/* Architecture */}
			<Card class="bg-card/70">
				<div class="flex items-center gap-2">
					<Server className="size-6" />
					<h2 class="font-kola text-2xl">Architecture</h2>
				</div>

				<p class="mt-3 text-sm text-muted-foreground">
					Xylo is designed as a modular ecosystem where the Discord bot and web dashboard communicate with a
					shared PostgreSQL database.
				</p>

				<div class="mt-6 flex flex-col items-center gap-3">
					{
						architecture.map((part) => (
							<div class="w-full rounded-2xl border border-border/50 bg-background/20 p-4 text-center">
								<part.icon className="mx-auto size-5" />
								<p class="mt-2 font-medium">{part.title}</p>
								<p class="mt-1 text-xs text-muted-foreground">{part.description}</p>
							</div>
						))
					}
				</div>
			</Card>
		</div>

		{/* Features */}
		<Card class="mt-4 bg-card/70">
			<div class="flex items-center gap-2">
				<Code2 className="size-6" />
				<h2 class="font-kola text-2xl">Features</h2>
			</div>

			<div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
				{
					features.map((feature) => (
						<div class="rounded-2xl border border-border/50 bg-background/20 p-5">
							<feature.icon className="size-5" />
							<h3 class="mt-3 font-medium">{feature.title}</h3>
							<p class="mt-1 text-sm text-muted-foreground">{feature.description}</p>
						</div>
					))
				}
			</div>
		</Card>

		{/* Changelog */}
		<Card class="mt-4 bg-card/70">
			<div class="flex items-center gap-2">
				<GitBranch className="size-6" />
				<h2 class="font-kola text-2xl">Changelog</h2>
			</div>

			<p class="mt-3 max-w-2xl text-sm text-muted-foreground">
				A chronological record of changes, new features, and improvements made to Xylo throughout its
				development.
			</p>

			<div class="mx-auto mt-10 max-w-4xl space-y-12">
				{
					changelog.map((release) => (
						<div class="relative border-l border-border/50 pl-8">
							{/* Timeline dot */}
							<div
								class="absolute -left-[5px] top-1 size-2.5 rounded-full"
								style={{ backgroundColor: release.color }}
							/>

							{/* Version + Date */}
							<div class="flex flex-wrap items-center gap-3">
								<h3 class="text-xl font-medium">{release.version}</h3>
								<span class="rounded-full border border-border/50 bg-background/30 px-3 py-1 text-xs text-muted-foreground">
									{release.date}
								</span>
							</div>

							<p class="mt-3 text-sm text-muted-foreground">{release.description}</p>

							<div class="mt-6 grid gap-6 sm:grid-cols-2">
								{[
									{ heading: "Added", group: release.added, empty: "Nothing was added." },
									{ heading: "Removed", group: release.removed, empty: "Nothing was removed." },
								].map(({ heading, group, empty }) => {
									const sections = changeSections(group);
									return (
										<div>
											<p class="text-sm font-medium">{heading}</p>
											{sections.length === 0 ? (
												<p class="mt-3 text-sm text-muted-foreground">{empty}</p>
											) : (
												sections.map((section, index) => (
													<div class={index === 0 ? "mt-3" : "mt-4"}>
														<p class="text-xs text-muted-foreground">{section.label}</p>
														<ul class="mt-2 space-y-2 text-sm text-muted-foreground">
															{section.items.map((item) => (
																<li class="flex items-start gap-2">
																	<CheckCircle2
																		className="mt-0.5 size-4 shrink-0"
																		style={{ color: release.color }}
																	/>
																	{item}
																</li>
															))}
														</ul>
													</div>
												))
											)}
										</div>
									);
								})}
							</div>

							{release.footer && (
								<p class="mt-6 border-t border-border/30 pt-4 text-xs text-muted-foreground">{release.footer}</p>
							)}
						</div>
					))
				}
			</div>
		</Card>
	</main>
</BaseLayout>
