---
import "../styles/globals.css";
import Header from "../components/Header";
import Particles from "../components/ui/Particles";

interface Props {
	title?: string;
	description?: string;
}

const SITE_TITLE = "tommasofatticcioni";
const DEFAULT_DESCRIPTION =
	"Personal portfolio of Tommaso Fatticcioni, a Software Developer focused on modern web development and backend systems.";

const { title, description = DEFAULT_DESCRIPTION } = Astro.props;
const ogImage = new URL("/og-image.png", Astro.site);
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" class="h-full antialiased">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="preload" href="/fonts/Satoshi-Regular.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/Kola-Regular.woff2" as="font" type="font/woff2" crossorigin />
		<meta name="generator" content={Astro.generator} />

		<title>{SITE_TITLE}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Tommaso Fatticcioni" />
		<meta name="creator" content="tommasofatticcioni" />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={canonical} />

		<meta property="og:type" content="website" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:site_name" content="tommasofatticcioni | Portfolio" />
		<meta property="og:title" content={SITE_TITLE} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Tommaso Fatticcioni — Software Developer" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={SITE_TITLE} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<!-- Apply the saved or system theme before first paint to avoid a flash. -->
		<script is:inline>
			(() => {
				let theme;
				try {
					theme = localStorage.getItem("theme");
				} catch {}
				if (theme !== "light" && theme !== "dark") {
					theme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
				}
				document.documentElement.classList.toggle("dark", theme === "dark");
				document.documentElement.style.colorScheme = theme;
			})();
		</script>
	</head>
	<body class="min-h-full flex flex-col">
		<Particles client:only="react" />

		<div class="relative z-10">
			<slot />
		</div>
	</body>
</html>
